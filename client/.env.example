# Base API URL của Backend Node.js
VITE_API_BASE_URL="http://localhost:5000/api"

# TMDb (The Movie Database) API Credentials
# Đăng ký tài khoản miễn phí tại: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY="your_tmdb_api_key_here"
VITE_TMDB_ACCESS_TOKEN="your_tmdb_read_access_token_here"
