PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:123456@localhost:3306/cinelight_db"

# JWT Authentication Secrets (Bắt buộc thay đổi trong môi trường production)
JWT_ACCESS_SECRET="cinelight-access-super-secret-key-2026-xyz"
JWT_REFRESH_SECRET="cinelight-refresh-super-secret-key-2026-abc"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Quy chuẩn giữ ghế chuẩn CGV/Lotte: 7 phút (420 giây)
SEAT_HOLD_DURATION_SECONDS=420

# Payment Webhook HMAC-SHA512 Secret
PAYMENT_WEBHOOK_SECRET="cinelight-payment-webhook-secret-2026-secure"

# Electronic Ticket QR HMAC-SHA256 Secret (Tách biệt hoàn toàn với Webhook Secret)
TICKET_QR_SECRET="cinelight-ticket-qr-secret-2026-distinct"

# Client URL (cho CORS)
CLIENT_URL="http://localhost:5173"
